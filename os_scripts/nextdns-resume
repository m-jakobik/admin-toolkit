#!/bin/sh

# Put this script in:
# /usr/lib/systemd/system-sleep/

LOG_FILE="/var/log/nextdns-resume.log"
MAX_RETRIES=10
NETWORK_OK=0

case "$1" in
    post)
        echo "$(date): Resume detected." >> "$LOG_FILE"

        # Wait for network connectivity
        COUNT=0
        while [ "$COUNT" -lt "$MAX_RETRIES" ]; do
            if ping -c 1 -W 1 1.1.1.1 >/dev/null 2>&1; then
                NETWORK_OK=1
                echo "$(date): Network available after ${COUNT}s." >> "$LOG_FILE"
                break
            fi

            COUNT=$((COUNT + 1))
            sleep 1
        done

        if [ "$NETWORK_OK" -eq 1 ]; then
            echo "$(date): Restarting NextDNS..." >> "$LOG_FILE"

            systemctl restart nextdns

            if /usr/bin/nextdns activate; then
                echo "$(date): NextDNS activated." >> "$LOG_FILE"
            else
                echo "$(date): ERROR: nextdns activate failed." >> "$LOG_FILE"
                exit 1
            fi

            RESPONSE=$(
                /usr/bin/curl -fsS \
                    --max-time 5 \
                    "https://link-ip.nextdns.io/89bd6a/d026f4ee8b51832d" \
                    2>/dev/null || echo "No response"
            )

            echo "$(date): NextDNS response: $RESPONSE" >> "$LOG_FILE"

        else
            echo "$(date): ERROR: Network unavailable after ${MAX_RETRIES}s." >> "$LOG_FILE"
        fi
        ;;
esac
